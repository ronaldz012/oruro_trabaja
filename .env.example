# Copia este archivo como .env y completa los valores.
SECRET_KEY=cambia-esta-clave-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Modo demostración: muestra el OTP en pantalla y no envía SMS reales
DEMO_MODE=True

PENDING_REGISTRATION_TTL_MINUTES=60
EMPRESA_MAX_OFERTAS_ACTIVAS=5
OTP_CODE_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
OTP_PHONE_MAX_SENDS=3
OTP_PHONE_WINDOW_HOURS=5
OTP_IP_MAX_SENDS=5
OTP_IP_WINDOW_HOURS=1

# Login: intentos fallidos por IP antes del timeout
LOGIN_MAX_ATTEMPTS=5
LOGIN_TIMEOUT_SECONDS=900

# Storage: local | s3 (Cloudflare R2)
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_PRIVATE_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ADDRESSING_STYLE=
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_QUERYSTRING_EXPIRE=3600

# Proveedor real de SMS (Textbee)
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
TEXTBEE_TIMEOUT_SECONDS=10

# Usuarios de desarrollo
SEED_ADMIN_EMAIL=admin@gador.gob.bo
SEED_ADMIN_PASSWORD=
SEED_EMPRESA_EMAIL=empresa@gador.gob.bo
SEED_EMPRESA_PASSWORD=
SEED_EMPRESA_PENDIENTE_EMAIL=empresa.pendiente@gador.gob.bo
SEED_EMPRESA_PENDIENTE_PASSWORD=
SEED_POSTULANTE_EMAIL=postulante@gador.gob.bo
SEED_POSTULANTE_PASSWORD=
SEED_POSTULANTE_CI=7654321 OR
